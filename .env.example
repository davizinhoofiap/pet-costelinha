# ======================================================
# CONFIGURAÇÕES E BANCO DE DADOS (MYSQL DA NUVEM / LOCAL)
# ======================================================
DATABASE_URL="mysql://usuario:senha@host.aivencloud.com:23172/defaultdb?ssl-mode=REQUIRED"
JWT_SECRET="sua_chave_secreta_jwt_para_assinar_tokens_aqui"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ======================================================
# 1. AUTENTICAÇÃO VIA GOOGLE OAUTH 2.0 (SOCIAL LOGIN)
# Obtenha no Google Cloud Console: https://console.cloud.google.com/apis/credentials
# ======================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID="1090723739206-85rcju3kl60ghp9t13ehqi9be9j4p2i9.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="1090723739206-85rcju3kl60ghp9t13ehqi9be9j4p2i9.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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i"

# ======================================================
# 2. CLOUDFLARE TURNSTILE (PROTEÇÃO ANTI-BOT EM FORMULÁRIOS)
# Obtenha no Dashboard da Cloudflare: https://dash.cloudflare.com/?to=/:account/turnstile
# Chaves de teste (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# ======================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ======================================================
# 3. UPSTASH REDIS (RATE LIMITING DE ALTA PERFORMANCE NA BORDA)
# Obtenha no Console da Upstash: https://console.upstash.com/redis
# ======================================================
UPSTASH_REDIS_REST_URL="https://sua-instancia.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token_rest_upstash_aqui"

# ======================================================
# GATEWAY DE PAGAMENTO PIX (MERCADO PAGO)
# ======================================================
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-seu_token_oficial_mercado_pago_aqui"

# ======================================================
# SERVIÇO DE E-MAIL TRANSACIONAL (NODEMAILER / SMTP)
# ======================================================
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="ethereal_user@ethereal.email"
SMTP_PASS="ethereal_pass"
EMAIL_FROM="contato@petcostelinha.com.br"
EMAIL_ADMIN="pedidos@petcostelinha.com.br"
